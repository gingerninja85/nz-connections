{
  "name": "nz-connections",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "try-it": "npm run db:local:setup && npm run dev -- --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:gets": "python3 tests/gets_local_integration_test.py",
    "gets:import:local": "python3 importers/gets/import_gets_local.py --input-dir ../nzrecords-research/mbie-procurement/raw --sample-file importers/gets/sample-rfx-10.json --db ../nzrecords-research/mbie-procurement/integration-report/nz-records-gets-dev.sqlite",
    "db:local:init": "wrangler d1 execute nz-connections --local --file=database/schema.sql",
    "db:local:seed": "wrangler d1 execute nz-connections --local --file=database/demo-realpath.sql",
    "db:local:setup": "npm run db:local:init && npm run db:local:seed",
    "nzbn:sql": "node importers/nzbn/to-sql.mjs",
    "charities:sql": "node importers/charities/to-sql.mjs",
    "charities:officers:sql": "node importers/charities/officers-to-sql.mjs",
    "test:phase9c-prep": "node --test tests/phase9c_prep.test.mjs",
    "charities:phase9c:snapshot:organisations": "node importers/charities/phase9c-prep.mjs snapshot --dataset=organisations --out=phase9c-prep/snapshots/organisations.ndjson --page-size=50000",
    "charities:phase9c:snapshot:officers": "node importers/charities/phase9c-prep.mjs snapshot --dataset=officers --out=phase9c-prep/snapshots/officers.ndjson --page-size=50000",
    "charities:phase9c:validate": "node importers/charities/phase9c-prep.mjs validate --organisations=phase9c-prep/snapshots/organisations.ndjson --officers=phase9c-prep/snapshots/officers.ndjson --out-dir=phase9c-prep/validation",
    "charities:phase9c:chunks": "node importers/charities/phase9c-prep.mjs chunks --charities=phase9c-prep/validation/charities.accepted.ndjson --officers=phase9c-prep/validation/officers.accepted.ndjson --out-dir=phase9c-prep/chunks --chunk-size=1000 --snapshot-id=local-phase9c"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
